--[[
    Chicken Farm - Auto Farm Script (Mobile Compatible)
    Game: Chicken Farm by Skandi Studios
    Version: 3.0
    Features:
      Auto Collect (smart sweep+return), Auto Sell/Deposit,
      Auto Buy Best Tier (100->25->5->1), Auto Upgrade Farm,
      Auto Merge Chickens, Auto Upgrade Sell Rate,
      Auto Rebirth, Anti-AFK, Speed Boost,
      Landscape Scrollable Tab GUI (Farm / Upgrade / Settings),
      Configurable Delays (live apply), Session Stats, Toasts
]]

-- ============================================================
-- SERVICES
-- ============================================================
local Players           = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")
local TweenService      = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

-- ============================================================
-- CONFIG  (live-editable via Settings tab)
-- ============================================================
local CONFIG = {
    CollectDelay     = 0.1,
    SellDelay        = 2,
    BuyDelay         = 2,
    RebirthDelay     = 8,
    UpgradeDelay     = 3,
    MergeDelay       = 1,
    SellRateDelay    = 3,
    AntiAFKInterval  = 55,
    NormalSpeed      = 16,
    BoostSpeed       = 60,
}

-- ============================================================
-- TOGGLE FLAGS
-- ============================================================
local Flags = {
    AutoCollect      = false,
    AutoSell         = false,
    AutoBuy          = false,
    AutoUpgrade      = false,
    AutoMerge        = false,
    AutoSellRate     = false,
    AutoRebirth      = false,
    AntiAFK          = false,
    SpeedBoost       = false,
}

-- ============================================================
-- RUNTIME STATS
-- ============================================================
local Stats = {
    EggsCollected   = 0,
    ChickensBought  = 0,
    UpgradesDone    = 0,
    SellsDone       = 0,
    MergesDone      = 0,
    SellRateDone    = 0,
}

-- ============================================================
-- CORE HELPERS
-- ============================================================
local function getRoot()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("Humanoid")
end

local function tpTo(part)
    local root = getRoot()
    if root and part and part.Parent then
        -- Land ON the surface of the part (center + half-height + character waist height)
        -- This handles step/platform boxes of any size correctly
        local surfaceOffset = (part.Size.Y / 2) + 3.2
        root.CFrame = CFrame.new(part.Position + Vector3.new(0, surfaceOffset, 0))
    end
end

local function getPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    return plots:FindFirstChild(player.Name)
end

local function getPlotButton(...)
    local plot = getPlot()
    if not plot then return nil end
    local current = plot:FindFirstChild("Buttons")
    if not current then return nil end
    for _, seg in ipairs({...}) do
        current = current:FindFirstChild(seg)
        if not current then return nil end
    end
    if current:IsA("BasePart") then return current end
    local btn = current:FindFirstChild("Button") or current:FindFirstChild("Hitbox")
    return btn or current:FindFirstChildOfClass("BasePart")
end

local function firePaper(action, ...)
    local paper = ReplicatedStorage:FindFirstChild("Paper")
    if not paper then return end
    local remotes = paper:FindFirstChild("Remotes")
    if not remotes then return end
    local re = remotes:FindFirstChild("__remoteevent")
    local rf = remotes:FindFirstChild("__remotefunction")
    if re then pcall(function(...) re:FireServer(action, ...) end, ...) end
    if rf then pcall(function(...) rf:InvokeServer(action, ...) end, ...) end
end

-- Search buttons folder for any part whose name matches keyword
local function findPlotButtonByKeyword(keyword)
    local plot = getPlot()
    if not plot then return nil end
    local buttons = plot:FindFirstChild("Buttons")
    if not buttons then return nil end
    for _, child in ipairs(buttons:GetDescendants()) do
        if child.Name:lower():find(keyword:lower()) and child:IsA("BasePart") then
            return child
        end
    end
    return nil
end

-- ============================================================
-- FEATURE: AUTO COLLECT EGGS (smart sweep + return to deposit)
-- ============================================================
local function autoCollect()
    local root = getRoot()
    if not root then return end
    local eggsFolder = workspace:FindFirstChild("Eggs")
    if not eggsFolder then return end

    local eggs = eggsFolder:GetChildren()
    if #eggs == 0 then return end

    for _, egg in ipairs(eggs) do
        if not Flags.AutoCollect then break end
        local main = egg:FindFirstChild("Main") or egg:FindFirstChildOfClass("BasePart")
        if main and main.Parent then
            root.CFrame = CFrame.new(main.Position + Vector3.new(0, 3, 0))
            Stats.EggsCollected = Stats.EggsCollected + 1
            task.wait(0.05)
        end
    end

    -- Return to deposit after sweep
    if Flags.AutoCollect then
        local depositHitbox = getPlotButton("DepositEggs", "Hitbox")
        if depositHitbox then
            tpTo(depositHitbox)
            task.wait(0.2)
        end
    end
end

-- ============================================================
-- FEATURE: AUTO SELL / DEPOSIT
-- Only deposits when egg multiplier on the DepositEggs button is >= MIN_MULT
-- Exact label path confirmed: DepositEggs > Model > inner > UI > Multi
-- Text format: "[x2 Eggs]", "[x1 Eggs]", etc.
-- ============================================================
local MIN_SELL_MULT = 1.40  -- only deposit when multiplier is this or higher

local function getEggMultiplier()
    local plot = getPlot()
    if not plot then return 1 end
    local buttons = plot:FindFirstChild("Buttons")
    if not buttons then return 1 end
    local depModel = buttons:FindFirstChild("DepositEggs")
    if not depModel then return 1 end

    -- ── Strategy A: use the exact confirmed path ──────────────────────────
    -- DepositEggs [Model] > Model [Model] > inner [Part] > UI [BillboardGui] > Multi [TextLabel]
    local innerModel = depModel:FindFirstChild("Model")
    local inner = innerModel and innerModel:FindFirstChild("inner")
    local ui = inner and inner:FindFirstChild("UI")
    local multiLabel = ui and ui:FindFirstChild("Multi")

    local rawText = multiLabel and multiLabel.Text or nil

    -- ── Strategy B: fallback — find any TextLabel named "Multi" inside DepositEggs ─
    if not rawText then
        for _, obj in ipairs(depModel:GetDescendants()) do
            if obj.Name == "Multi" and (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
                rawText = obj.Text
                break
            end
        end
    end

    if rawText then
        -- Text looks like "[x2 Eggs]" or "[x1.5 Eggs]"
        -- Extract the number after 'x' or 'X'
        local m = rawText:match("[xX](%d+%.?%d*)")
        if m then
            local val = tonumber(m)
            if val then return val end
        end
    end

    -- Could not read — return 1 (will block deposits, which is the safe default)
    return 1
end

-- DEBUG: shows live multiplier as a toast — REMOVE this block once confirmed working
local _lastMultToast = 0
local function debugMultToast()
    local now = tick()
    if now - _lastMultToast > 10 then  -- max once every 10s
        _lastMultToast = now
        local m = getEggMultiplier()
        local col = m >= MIN_SELL_MULT and Color3.fromRGB(80, 210, 100) or Color3.fromRGB(210, 80, 80)
        showToast("Egg Mult: x" .. tostring(m) .. " (need x" .. tostring(MIN_SELL_MULT) .. "+)", col)
    end
end

local function autoSell()
    -- Gate: only deposit/sell when multiplier is high enough
    local mult = getEggMultiplier()
    debugMultToast()  -- TEMP: show live value; remove once confirmed working
    if mult < MIN_SELL_MULT then
        return  -- multiplier too low, skip this cycle
    end

    local depositHitbox = getPlotButton("DepositEggs", "Hitbox")
    if depositHitbox then tpTo(depositHitbox); task.wait(0.3) end

    local collectBtn = getPlotButton("CollectMoney", "Button")
    if collectBtn then tpTo(collectBtn); task.wait(0.3) end

    firePaper("Sell")
    firePaper("SellEggs")
    firePaper("CollectMoney")
    Stats.SellsDone = Stats.SellsDone + 1

end

-- ============================================================
-- FEATURE: LUCKY BLOCK DETECTION & AUTO-OPEN
-- If the player has a Lucky Block tool (in hand or backpack),
-- collect money first then open/use the block before buying.
-- ============================================================
local LUCKY_KEYWORDS = { "lucky", "luckyblock", "lucky_block", "luckbox", "luck" }

local function findLuckyBlock()
    local char = player.Character
    -- Check equipped tools (in character)
    if char then
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") then
                local n = obj.Name:lower()
                for _, kw in ipairs(LUCKY_KEYWORDS) do
                    if n:find(kw) then return obj end
                end
            end
        end
    end
    -- Check backpack
    local bp = player:FindFirstChild("Backpack")
    if bp then
        for _, obj in ipairs(bp:GetChildren()) do
            if obj:IsA("Tool") then
                local n = obj.Name:lower()
                for _, kw in ipairs(LUCKY_KEYWORDS) do
                    if n:find(kw) then return obj end
                end
            end
        end
    end
    return nil
end

local function openLuckyBlock(tool)
    -- 1. Collect money first (good practice before opening)
    local collectBtn = getPlotButton("CollectMoney", "Button")
    if collectBtn then tpTo(collectBtn); task.wait(0.4) end
    firePaper("CollectMoney")
    task.wait(0.2)

    -- 2. Equip the tool if it's in the backpack
    local hum = getHumanoid()
    if hum and tool and tool.Parent ~= player.Character then
        pcall(function() hum:EquipTool(tool) end)
        task.wait(0.3)
    end

    -- 3. Activate the tool (simulates clicking)
    if tool and tool.Parent then
        pcall(function() tool:Activate() end)
        task.wait(0.3)
    end

    -- 4. Also fire common lucky-block remotes as fallback
    for _, action in ipairs({
        "OpenLuckyBlock", "UseLuckyBlock", "LuckyBlock",
        "OpenBox", "UseBox", "OpenLucky", "UseLucky",
        "OpenCrate", "UseCrate",
    }) do
        firePaper(action)
        firePaper(action, 1)
        firePaper(action, true)
    end
end

-- ============================================================
-- FEATURE: AUTO BUY BEST TIER (100 -> 25 -> 5 -> 1)
-- Checks for Lucky Block first — opens it and skips buying this cycle
-- ============================================================
local BUY_TIERS = {
    { qty = 100, path = { "BuyChickens", "Buy100", "Button" } },
    { qty = 25,  path = { "BuyChickens", "Buy25",  "Button" } },
    { qty = 5,   path = { "BuyChickens", "Buy5",   "Button" } },
    { qty = 1,   path = { "BuyChickens", "Buy1",   "Button" } },
}

local function autoBuy()
    -- Priority: if player is holding a Lucky Block, open it first this cycle
    local luckyTool = findLuckyBlock()
    if luckyTool then
        openLuckyBlock(luckyTool)
        return  -- skip buying chickens this cycle
    end

    for _, tier in ipairs(BUY_TIERS) do
        local btn = getPlotButton(table.unpack(tier.path))
        if btn then
            tpTo(btn)
            task.wait(0.2)
            firePaper("BuyChicken", tier.qty)
            firePaper("Buy", "Chicken", tier.qty)
            Stats.ChickensBought = Stats.ChickensBought + tier.qty
            return
        end
    end
    firePaper("BuyChicken", 1)
    firePaper("Buy", "Chicken")
end

-- ============================================================
-- FEATURE: AUTO UPGRADE FARM
-- ============================================================
local UPGRADE_ACTIONS = {
    "Upgrade", "UpgradeFarm", "UpgradeChicken", "UpgradeCoop",
    "BuyUpgrade", "FarmUpgrade", "ChickenUpgrade", "PrestigeUpgrade",
    "Upgrade1", "Upgrade2", "Upgrade3",
}

local function autoUpgrade()
    local plot = getPlot()
    if plot then
        local buttons = plot:FindFirstChild("Buttons")
        if buttons then
            for _, child in ipairs(buttons:GetChildren()) do
                local n = child.Name:lower()
                if n:find("upgrade") and not n:find("sell") and not n:find("rate") then
                    local btn = child:FindFirstChild("Button")
                             or child:FindFirstChild("Hitbox")
                             or child:FindFirstChildOfClass("BasePart")
                    if btn then tpTo(btn); task.wait(0.15) end
                end
            end
        end
    end
    for _, action in ipairs(UPGRADE_ACTIONS) do
        firePaper(action)
        firePaper(action, 1)
    end
    Stats.UpgradesDone = Stats.UpgradesDone + 1
end

-- ============================================================
-- FEATURE: AUTO MERGE CHICKENS
-- Looks for: Merge / MergeChicken / MergeAll buttons in plot
-- Also fires remote variants
-- ============================================================
local MERGE_ACTIONS = {
    "Merge", "MergeChicken", "MergeChickens", "MergeAll",
    "AutoMerge", "CombineChicken", "CombineAll",
}

local function autoMerge()
    -- Try plot buttons first (keywords: merge, combine)
    local plot = getPlot()
    if plot then
        local buttons = plot:FindFirstChild("Buttons")
        if buttons then
            for _, child in ipairs(buttons:GetDescendants()) do
                local n = child.Name:lower()
                if (n:find("merge") or n:find("combine")) and child:IsA("BasePart") then
                    tpTo(child)
                    task.wait(0.15)
                end
            end
        end
    end

    -- Also search workspace for merge zones (some games put them in world)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n == "mergebutton" or n == "mergehitbox" or n == "mergeall" then
                tpTo(obj)
                task.wait(0.1)
            end
        end
    end

    -- Fire known merge remotes
    for _, action in ipairs(MERGE_ACTIONS) do
        firePaper(action)
        firePaper(action, true)
        firePaper(action, 1)
    end
    Stats.MergesDone = Stats.MergesDone + 1
end

-- ============================================================
-- FEATURE: AUTO UPGRADE SELL RATE
-- Strategy 1 (PRIMARY): Scan for any TextLabel/BillboardGui/SurfaceGui
--   whose text matches "+X per second" — the visual label above the button.
--   Walk up to find the owning BasePart and teleport to it.
-- Strategy 2 (FALLBACK): Keyword scan on button names + remote fire.
-- ============================================================
local SELLRATE_ACTIONS = {
    "UpgradeSellRate", "SellRateUpgrade", "UpgradeRate",
    "IncomeUpgrade", "UpgradeIncome", "MoneyRateUpgrade",
    "UpgradeMoney", "SellUpgrade", "RateUpgrade",
    "UpgradeSell", "UpgradeSellRates",
    "UpgradeSelling", "SellingUpgrade", "UpgradeMoneyRate",
    "UpgradeEarnings", "EarningsUpgrade",
    "UpgradePassive", "PassiveUpgrade",
    "UpgradeProfit", "ProfitUpgrade",
}

-- Walk up the instance tree from 'inst' to find a BasePart ancestor
local function findBasePart(inst)
    local cur = inst
    for _ = 1, 8 do
        if not cur then break end
        if cur:IsA("BasePart") then return cur end
        cur = cur.Parent
    end
    return nil
end

-- Returns true if a TextLabel/TextButton text looks like "+X per second"
local function isPerSecondLabel(text)
    if not text or text == "" then return false end
    local t = text:lower()
    return t:find("per second") or t:find("per sec") or t:find("/sec") or t:find("/s")
        or t:find("per min") or t:find("/min")
        or (t:find("%+") and (t:find("second") or t:find("income") or t:find("earn")))
end

local function autoSellRate()
    local hitParts = {}  -- collect unique BaseParts to visit
    local seen = {}

    -- ── Strategy 1: find parts with "+X per second" label text ──────────────
    -- IMPORTANT: only scan the LOCAL player's own plot to avoid visiting other players' plots
    local plot = getPlot()
    if not plot then return end  -- no plot found, bail out entirely
    local searchRoots = { plot }

    for _, root in ipairs(searchRoots) do
        for _, obj in ipairs(root:GetDescendants()) do
            local text = nil
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                text = obj.Text
            end
            if text and isPerSecondLabel(text) then
                local part = findBasePart(obj)
                if part and not seen[part] then
                    seen[part] = true
                    table.insert(hitParts, part)
                end
                -- Also try the parent BillboardGui/SurfaceGui's Adornee/Part
                -- but ONLY if the adornee belongs to our plot
                local gui = obj.Parent
                while gui and not (gui:IsA("BillboardGui") or gui:IsA("SurfaceGui")) do
                    gui = gui.Parent
                end
                if gui then
                    local adornee = (gui:IsA("BillboardGui") and gui.Adornee)
                              or (gui:IsA("SurfaceGui") and gui.Parent)
                    if adornee and adornee:IsA("BasePart")
                       and adornee:IsDescendantOf(plot)   -- ← must be on OUR plot
                       and not seen[adornee] then
                        seen[adornee] = true
                        table.insert(hitParts, adornee)
                    end
                end
            end
        end
    end

    -- Visit every found part — wait long enough for the proximity trigger to register
    if #hitParts > 0 then
        for _, part in ipairs(hitParts) do
            if not Flags.AutoSellRate then break end
            tpTo(part)
            task.wait(1.5)   -- stay on the step long enough for the server to register
        end
    else
        -- ── Strategy 2: keyword scan on Buttons folder (also plot-scoped) ─────
        if plot then
            local buttons = plot:FindFirstChild("Buttons")
            if buttons then
                local collectBtn = getPlotButton("CollectMoney", "Button")
                local collectPos = collectBtn and collectBtn.Position or nil
                for _, child in ipairs(buttons:GetDescendants()) do
                    local n = child.Name:lower()
                    local isSellRate = n:find("sellrate") or n:find("sell_rate")
                        or n:find("incomeupgrade") or n:find("moneyrate")
                        or n:find("rateupgrade") or (n:find("rate") and n:find("upg"))
                        or (n:find("sell") and n:find("upg") and not n:find("egg"))
                        or n:find("sellupgrade") or n:find("upgradesell")
                        or n:find("earning") or n:find("passive") or n:find("profit")
                    if isSellRate and child:IsA("BasePart") then
                        tpTo(child); task.wait(0.15)
                    end
                end
                -- proximity scan near CollectMoney
                if collectPos then
                    for _, child in ipairs(buttons:GetDescendants()) do
                        if child:IsA("BasePart") then
                            local dist = (child.Position - collectPos).Magnitude
                            local n = child.Name:lower()
                            if dist < 30 and (n:find("upgrade") or n:find("buy") or n:find("rate")) then
                                tpTo(child); task.wait(0.12)
                            end
                        end
                    end
                end
            end
        end
    end

    -- ── Always fire known remotes as a belt-and-suspenders approach ──────────
    for _, action in ipairs(SELLRATE_ACTIONS) do
        firePaper(action)
        firePaper(action, 1)
        firePaper(action, true)
    end
    Stats.SellRateDone = Stats.SellRateDone + 1
end

-- ============================================================
-- FEATURE: AUTO REBIRTH
-- ============================================================
local function autoRebirth()
    firePaper("Rebirth")
    firePaper("Prestige")
    firePaper("DoRebirth")
    firePaper("Rebirth", true)
    firePaper("Rebirth", 1)
end

-- ============================================================
-- FEATURE: ANTI-AFK
-- ============================================================
local VirtualUser
pcall(function() VirtualUser = game:GetService("VirtualUser") end)

local function antiAFK()
    local hum = getHumanoid()
    if hum then hum.Jump = true end
    if VirtualUser then
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new(0, 0))
        end)
    end
end

-- ============================================================
-- FEATURE: SPEED BOOST
-- ============================================================
local function applySpeed()
    local hum = getHumanoid()
    if hum then
        hum.WalkSpeed = Flags.SpeedBoost and CONFIG.BoostSpeed or CONFIG.NormalSpeed
    end
end

player.CharacterAdded:Connect(function(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if hum then task.wait(1); applySpeed() end
end)

-- ============================================================
-- MAIN LOOPS
-- ============================================================
task.spawn(function()
    while true do
        task.wait(CONFIG.CollectDelay)
        if Flags.AutoCollect then pcall(autoCollect) end
    end
end)

task.spawn(function()
    while true do
        task.wait(CONFIG.SellDelay)
        if Flags.AutoSell then pcall(autoSell) end
    end
end)

task.spawn(function()
    while true do
        task.wait(CONFIG.BuyDelay)
        if Flags.AutoBuy then pcall(autoBuy) end
    end
end)

task.spawn(function()
    while true do
        task.wait(CONFIG.UpgradeDelay)
        if Flags.AutoUpgrade then pcall(autoUpgrade) end
    end
end)

task.spawn(function()
    while true do
        task.wait(CONFIG.MergeDelay)
        if Flags.AutoMerge then pcall(autoMerge) end
    end
end)

task.spawn(function()
    while true do
        task.wait(CONFIG.SellRateDelay)
        if Flags.AutoSellRate then pcall(autoSellRate) end
    end
end)

task.spawn(function()
    while true do
        task.wait(CONFIG.RebirthDelay)
        if Flags.AutoRebirth then pcall(autoRebirth) end
    end
end)

task.spawn(function()
    while true do
        task.wait(CONFIG.AntiAFKInterval)
        if Flags.AntiAFK then pcall(antiAFK) end
    end
end)

