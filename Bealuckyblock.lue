-- 6 stats in 2 columns
local STAT_GRID = {
    { key = "EggsCollected",  label = "Eggs",      col = 0 },
    { key = "ChickensBought", label = "Chickens",  col = 1 },
    { key = "UpgradesDone",   label = "FarmUpg",   col = 0 },
    { key = "SellRateDone",   label = "SellRate",  col = 1 },
    { key = "MergesDone",     label = "Merges",    col = 0 },
    { key = "SellsDone",      label = "Sells",     col = 1 },
}
local statValueLabels = {}
local rowY = 30
local col0x, col1x = 10, 210
local rowH = 18
local colCount = { [0] = 0, [1] = 0 }

for _, sr in ipairs(STAT_GRID) do
    local cx = sr.col == 0 and col0x or col1x
    local y  = rowY + colCount[sr.col] * (rowH + 2)
    colCount[sr.col] = colCount[sr.col] + 1

    local lName = Instance.new("TextLabel", statsCard)
    lName.Size = UDim2.new(0, 90, 0, rowH)
    lName.Position = UDim2.new(0, cx, 0, y)
    lName.BackgroundTransparency = 1
    lName.Text = sr.label .. ":"
    lName.Font = Enum.Font.Gotham
    lName.TextSize = 10
    lName.TextColor3 = Color3.fromRGB(130, 130, 158)
    lName.TextXAlignment = Enum.TextXAlignment.Left

    local lVal = Instance.new("TextLabel", statsCard)
    lVal.Size = UDim2.new(0, 80, 0, rowH)
    lVal.Position = UDim2.new(0, cx + 88, 0, y)
    lVal.BackgroundTransparency = 1
    lVal.Text = "0"
    lVal.Font = Enum.Font.GothamBold
    lVal.TextSize = 11
    lVal.TextColor3 = Color3.fromRGB(95, 225, 120)
    lVal.TextXAlignment = Enum.TextXAlignment.Left

    statValueLabels[sr.key] = lVal
end

task.spawn(function()
    while true do
        task.wait(1)
        for key, lbl in pairs(statValueLabels) do
            lbl.Text = tostring(Stats[key])
        end
    end
end)

