-- ── Tab Bar ─────────────────────────────────────────────────
local TAB_Y = TITLE_H + 1

local TabBar = Instance.new("Frame", Window)
TabBar.Size             = UDim2.new(1, -16, 0, TAB_H)
TabBar.Position         = UDim2.new(0, 8, 0, TAB_Y + 4)
TabBar.BackgroundColor3 = Color3.fromRGB(16, 16, 24)
TabBar.BorderSizePixel  = 0
Instance.new("UICorner", TabBar).CornerRadius = UDim.new(0, 8)

local tabLL = Instance.new("UIListLayout", TabBar)
tabLL.FillDirection = Enum.FillDirection.Horizontal
tabLL.SortOrder     = Enum.SortOrder.LayoutOrder

local tabButtons = {}
local tabPages   = {}

local TABS = { "Farm", "Upgrades", "Settings" }

local CONTENT_Y = TAB_Y + TAB_H + 10
local CONTENT_H = WIN_H - CONTENT_Y - STATUS_H - 6

-- ── Status Bar (thin, bottom) ────────────────────────────────
local StatusBar = Instance.new("Frame", Window)
StatusBar.Size             = UDim2.new(1, 0, 0, STATUS_H)
StatusBar.AnchorPoint      = Vector2.new(0, 1)
StatusBar.Position         = UDim2.new(0, 0, 1, 0)
StatusBar.BackgroundColor3 = Color3.fromRGB(16, 16, 26)
StatusBar.BorderSizePixel  = 0
Instance.new("UICorner", StatusBar).CornerRadius = UDim.new(0, 12)

local sbFix = Instance.new("Frame", StatusBar)
sbFix.Size             = UDim2.new(1, 0, 0, 12)
sbFix.BackgroundColor3 = Color3.fromRGB(16, 16, 26)
sbFix.BorderSizePixel  = 0

local StatusLabel = Instance.new("TextLabel", StatusBar)
StatusLabel.Size               = UDim2.new(1, -12, 1, 0)
StatusLabel.Position           = UDim2.new(0, 10, 0, 0)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Text               = "All features OFF"
StatusLabel.Font               = Enum.Font.Gotham
StatusLabel.TextSize           = 10
StatusLabel.TextColor3         = Color3.fromRGB(80, 80, 100)
StatusLabel.TextXAlignment     = Enum.TextXAlignment.Left

local function refreshStatus()
    local on = {}
    if Flags.AutoCollect  then table.insert(on, "Collect")   end
    if Flags.AutoSell     then table.insert(on, "Sell")      end
    if Flags.AutoBuy      then table.insert(on, "Buy")       end
    if Flags.AutoUpgrade  then table.insert(on, "FarmUpg")   end
    if Flags.AutoMerge    then table.insert(on, "Merge")     end
    if Flags.AutoSellRate then table.insert(on, "SellRate")  end
    if Flags.AutoRebirth  then table.insert(on, "Rebirth")   end
    if Flags.AntiAFK      then table.insert(on, "AFK")       end
    if Flags.SpeedBoost   then table.insert(on, "Speed")     end
    if #on == 0 then
        StatusLabel.Text       = "All features OFF"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 80, 100)
        TitleStatus.Text       = "Idle"
        TitleStatus.TextColor3 = Color3.fromRGB(90, 90, 110)
    else
        local txt = table.concat(on, "  ")
        StatusLabel.Text       = "ON: " .. txt
        StatusLabel.TextColor3 = Color3.fromRGB(100, 230, 130)
        TitleStatus.Text       = table.concat(on, " | ")
        TitleStatus.TextColor3 = Color3.fromRGB(100, 230, 130)
    end
end

-- ── Toast helper ─────────────────────────────────────────────
local function showToast(msg, color)
    color = color or Color3.fromRGB(85, 215, 105)
    local t = Instance.new("Frame", ScreenGui)
    t.Size             = UDim2.new(0, 310, 0, 38)
    t.AnchorPoint      = Vector2.new(0.5, 1)
    t.Position         = UDim2.new(0.5, 0, 1, 10)   -- below screen
    t.BackgroundColor3 = Color3.fromRGB(12, 18, 12)
    t.BorderSizePixel  = 0
    t.ZIndex           = 10
    Instance.new("UICorner", t).CornerRadius = UDim.new(0, 8)
    local ts = Instance.new("UIStroke", t)
    ts.Color = color; ts.Thickness = 1.2
    local tl = Instance.new("TextLabel", t)
    tl.Size               = UDim2.new(1, -12, 1, 0)
    tl.Position           = UDim2.new(0, 12, 0, 0)
    tl.BackgroundTransparency = 1
    tl.Text               = msg
    tl.Font               = Enum.Font.GothamBold
    tl.TextSize           = 11
    tl.TextColor3         = color
    tl.TextXAlignment     = Enum.TextXAlignment.Left
    tl.ZIndex             = 11
    -- slide up from bottom
    TweenService:Create(t, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, 0, 1, -48),
    }):Play()
    task.delay(2.2, function()
        TweenService:Create(t, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, 0, 1, 10),
        }):Play()
        task.delay(0.3, function() pcall(function() t:Destroy() end) end)
    end)
end

-- ── Page factory (uses ScrollingFrame) ──────────────────────
local function makePage(name)
    local clip = Instance.new("Frame", Window)
    clip.Name                 = "Clip_" .. name
    clip.Size                 = UDim2.new(1, 0, 0, CONTENT_H)
    clip.Position             = UDim2.new(0, 0, 0, CONTENT_Y)
    clip.BackgroundTransparency = 1
    clip.Visible              = false
    clip.ClipsDescendants     = true

    local scroll = Instance.new("ScrollingFrame", clip)
    scroll.Name                  = "Scroll"
    scroll.Size                  = UDim2.new(1, 0, 1, 0)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel       = 0
    scroll.ScrollBarThickness    = 3
    scroll.ScrollBarImageColor3  = Color3.fromRGB(255, 195, 0)
    scroll.ScrollBarImageTransparency = 0.5
    scroll.CanvasSize            = UDim2.new(0, 0, 0, 0)  -- auto via UIListLayout
    scroll.AutomaticCanvasSize   = Enum.AutomaticSize.Y
    scroll.ElasticBehavior       = Enum.ElasticBehavior.Always

    tabPages[name] = { clip = clip, scroll = scroll }
    return scroll  -- callers add children to scroll
end

-- ── Tab switcher ─────────────────────────────────────────────
local function setTab(name)
    for tName, pg in pairs(tabPages) do
        pg.clip.Visible = (tName == name)
    end
    for tName, tbtn in pairs(tabButtons) do
        local active = (tName == name)
        local ti = TweenInfo.new(0.14, Enum.EasingStyle.Quad)
        TweenService:Create(tbtn, ti, {
            BackgroundColor3 = active and Color3.fromRGB(52, 52, 80) or Color3.fromRGB(16, 16, 24),
            TextColor3       = active and Color3.fromRGB(255, 215, 50) or Color3.fromRGB(100, 100, 125),
        }):Play()
    end
end

local tabW = (WIN_W - 16) / #TABS
for i, tName in ipairs(TABS) do
    local tb = Instance.new("TextButton", TabBar)
    tb.Size             = UDim2.new(0, tabW, 1, 0)
    tb.BackgroundColor3 = Color3.fromRGB(16, 16, 24)
    tb.BorderSizePixel  = 0
    tb.Text             = tName
    tb.Font             = Enum.Font.GothamSemibold
    tb.TextSize         = 11
    tb.TextColor3       = Color3.fromRGB(100, 100, 125)
    tb.LayoutOrder      = i
    Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 7)
    tabButtons[tName] = tb
    tb.MouseButton1Click:Connect(function() setTab(tName) end)
end

-- ============================================================
-- Toggle row factory  (compact for landscape)
-- ============================================================
local function makeToggle(parent, data)
    local row = Instance.new("Frame", parent)
    row.Name             = "Row_" .. data.flag
    row.Size             = UDim2.new(1, 0, 0, 38)
    row.BackgroundColor3 = Color3.fromRGB(19, 19, 30)
    row.BorderSizePixel  = 0
    row.LayoutOrder      = data.order
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size               = UDim2.new(1, -68, 1, 0)
    lbl.Position           = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text               = data.label
    lbl.Font               = Enum.Font.Gotham
    lbl.TextSize           = 12
    lbl.TextColor3         = Color3.fromRGB(185, 185, 200)
    lbl.TextXAlignment     = Enum.TextXAlignment.Left
    lbl.TextYAlignment     = Enum.TextYAlignment.Center

    local pill = Instance.new("Frame", row)
    pill.Size             = UDim2.new(0, 42, 0, 24)
    pill.AnchorPoint      = Vector2.new(1, 0.5)
    pill.Position         = UDim2.new(1, -10, 0.5, 0)
    pill.BackgroundColor3 = Color3.fromRGB(42, 42, 58)
    pill.BorderSizePixel  = 0
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame", pill)
    dot.Size             = UDim2.new(0, 18, 0, 18)
    dot.AnchorPoint      = Vector2.new(0, 0.5)
    dot.Position         = UDim2.new(0, 3, 0.5, 0)
    dot.BackgroundColor3 = Color3.fromRGB(130, 130, 150)
    dot.BorderSizePixel  = 0
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local btn = Instance.new("TextButton", row)
    btn.Size               = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text               = ""

    local function setPill(state)
        local ti = TweenInfo.new(0.16, Enum.EasingStyle.Quad)
        if state then
            TweenService:Create(pill, ti, { BackgroundColor3 = Color3.fromRGB(80, 210, 100) }):Play()
            TweenService:Create(dot,  ti, { Position = UDim2.new(1, -21, 0.5, 0), BackgroundColor3 = Color3.fromRGB(255, 255, 255) }):Play()
            TweenService:Create(lbl,  ti, { TextColor3 = Color3.fromRGB(235, 235, 255) }):Play()
            TweenService:Create(row,  ti, { BackgroundColor3 = Color3.fromRGB(22, 27, 38) }):Play()
        else
            TweenService:Create(pill, ti, { BackgroundColor3 = Color3.fromRGB(42, 42, 58) }):Play()
            TweenService:Create(dot,  ti, { Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = Color3.fromRGB(130, 130, 150) }):Play()
            TweenService:Create(lbl,  ti, { TextColor3 = Color3.fromRGB(185, 185, 200) }):Play()
            TweenService:Create(row,  ti, { BackgroundColor3 = Color3.fromRGB(19, 19, 30) }):Play()
        end
    end

    btn.MouseButton1Click:Connect(function()
        Flags[data.flag] = not Flags[data.flag]
        setPill(Flags[data.flag])
        refreshStatus()
        if data.flag == "SpeedBoost" then applySpeed() end
        if Flags[data.flag] then
            showToast(data.label .. " ON", Color3.fromRGB(80, 210, 100))
        else
            showToast(data.label .. " OFF", Color3.fromRGB(210, 80, 80))
        end
    end)
end

-- ============================================================
-- Helper: standard scroll page layout setup
-- ============================================================
local function addScrollLayout(scroll, padH)
    padH = padH or 8
    local layout = Instance.new("UIListLayout", scroll)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding   = UDim.new(0, 5)
    local pad = Instance.new("UIPadding", scroll)
    pad.PaddingLeft   = UDim.new(0, padH)
    pad.PaddingRight  = UDim.new(0, padH)
    pad.PaddingTop    = UDim.new(0, 5)
    pad.PaddingBottom = UDim.new(0, 5)
end

