local SetScroll = makePage("Settings")
addScrollLayout(SetScroll)

local setHeader = Instance.new("TextLabel", SetScroll)
setHeader.Size               = UDim2.new(1, 0, 0, 18)
setHeader.BackgroundTransparency = 1
setHeader.Text               = "Edit value, press [v] to apply live"
setHeader.Font               = Enum.Font.Gotham
setHeader.TextSize           = 10
setHeader.TextColor3         = Color3.fromRGB(100, 100, 135)
setHeader.TextXAlignment     = Enum.TextXAlignment.Left
setHeader.LayoutOrder        = 0

local SETTING_ROWS = {
    { key = "CollectDelay",   label = "Collect Delay (s)",    order = 1, min = 0.05, max = 5   },
    { key = "SellDelay",      label = "Sell Delay (s)",       order = 2, min = 0.5,  max = 15  },
    { key = "BuyDelay",       label = "Buy Delay (s)",        order = 3, min = 0.5,  max = 15  },
    { key = "UpgradeDelay",   label = "Upgrade Delay (s)",    order = 4, min = 0.5,  max = 30  },
    { key = "MergeDelay",     label = "Merge Delay (s)",      order = 5, min = 0.2,  max = 10  },
    { key = "SellRateDelay",  label = "Sell Rate Delay (s)",  order = 6, min = 0.5,  max = 30  },
    { key = "RebirthDelay",   label = "Rebirth Delay (s)",    order = 7, min = 1,    max = 60  },
    { key = "BoostSpeed",     label = "Boost Speed",          order = 8, min = 16,   max = 200 },
}

local function makeSettingRow(data)
    local row = Instance.new("Frame", SetScroll)
    row.Name             = "Set_" .. data.key
    row.Size             = UDim2.new(1, 0, 0, 38)
    row.BackgroundColor3 = Color3.fromRGB(17, 17, 28)
    row.BorderSizePixel  = 0
    row.LayoutOrder      = data.order
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)

    local nameLbl = Instance.new("TextLabel", row)
    nameLbl.Size               = UDim2.new(0.55, 0, 0.55, 0)
    nameLbl.Position           = UDim2.new(0, 10, 0, 4)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text               = data.label
    nameLbl.Font               = Enum.Font.Gotham
    nameLbl.TextSize           = 11
    nameLbl.TextColor3         = Color3.fromRGB(185, 185, 205)
    nameLbl.TextXAlignment     = Enum.TextXAlignment.Left

    local curLbl = Instance.new("TextLabel", row)
    curLbl.Size               = UDim2.new(0.55, 0, 0.4, 0)
    curLbl.Position           = UDim2.new(0, 10, 0.55, 0)
    curLbl.BackgroundTransparency = 1
    curLbl.Text               = "Now: " .. tostring(CONFIG[data.key])
    curLbl.Font               = Enum.Font.Gotham
    curLbl.TextSize           = 9
    curLbl.TextColor3         = Color3.fromRGB(85, 85, 115)
    curLbl.TextXAlignment     = Enum.TextXAlignment.Left

    local input = Instance.new("TextBox", row)
    input.Size               = UDim2.new(0, 55, 0, 24)
    input.AnchorPoint        = Vector2.new(1, 0.5)
    input.Position           = UDim2.new(1, -42, 0.5, 0)
    input.BackgroundColor3   = Color3.fromRGB(25, 25, 40)
    input.BorderSizePixel    = 0
    input.Text               = tostring(CONFIG[data.key])
    input.Font               = Enum.Font.GothamSemibold
    input.TextSize           = 11
    input.TextColor3         = Color3.fromRGB(215, 215, 235)
    input.ClearTextOnFocus   = false
    Instance.new("UICorner", input).CornerRadius = UDim.new(0, 5)
    local inpS = Instance.new("UIStroke", input)
    inpS.Color = Color3.fromRGB(55, 55, 85); inpS.Thickness = 1

    local applyBtn = Instance.new("TextButton", row)
    applyBtn.Size             = UDim2.new(0, 26, 0, 24)
    applyBtn.AnchorPoint      = Vector2.new(1, 0.5)
    applyBtn.Position         = UDim2.new(1, -10, 0.5, 0)
    applyBtn.BackgroundColor3 = Color3.fromRGB(45, 170, 75)
    applyBtn.BorderSizePixel  = 0
    applyBtn.Text             = "v"
    applyBtn.Font             = Enum.Font.GothamBold
    applyBtn.TextSize         = 13
    applyBtn.TextColor3       = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", applyBtn).CornerRadius = UDim.new(0, 5)

    applyBtn.MouseButton1Click:Connect(function()
        local v = tonumber(input.Text)
        if v then
            v = math.clamp(v, data.min, data.max)
            CONFIG[data.key] = v
            input.Text = tostring(v)
            curLbl.Text = "Now: " .. tostring(v)
            if data.key == "BoostSpeed" then applySpeed() end
            TweenService:Create(applyBtn, TweenInfo.new(0.1), { BackgroundColor3 = Color3.fromRGB(90, 240, 120) }):Play()
            task.delay(0.4, function()
                TweenService:Create(applyBtn, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(45, 170, 75) }):Play()
            end)
            showToast(data.label .. " = " .. tostring(v), Color3.fromRGB(100, 195, 255))
        else
            TweenService:Create(applyBtn, TweenInfo.new(0.1), { BackgroundColor3 = Color3.fromRGB(210, 65, 65) }):Play()
            task.delay(0.4, function()
                TweenService:Create(applyBtn, TweenInfo.new(0.2), { BackgroundColor3 = Color3.fromRGB(45, 170, 75) }):Play()
            end)
        end
    end)
end

for _, d in ipairs(SETTING_ROWS) do makeSettingRow(d) end

-- activate first tab
setTab("Farm")

-- ============================================================
-- DRAG (title bar)
-- ============================================================
local dragging, dragStart, startPos

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging  = true
        dragStart = input.Position
        startPos  = Window.Position
    end
end)
TitleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement or
        input.UserInputType == Enum.UserInputType.Touch
    ) then
        local d = input.Position - dragStart
        Window.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end
end)

-- ============================================================
-- MINIMIZE
-- ============================================================
local minimized = false
MinBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    TweenService:Create(Window, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
        Size = minimized
            and UDim2.new(0, WIN_W, 0, TITLE_H)
            or  UDim2.new(0, WIN_W, 0, WIN_H),
    }):Play()
    MinBtn.Text = minimized and "+" or "-"
end)

-- ============================================================
-- STARTUP
-- ============================================================
showToast("Chicken Farm v3.0 Loaded!", Color3.fromRGB(255, 205, 30))
print("[ChickenFarm v3] Loaded! Farm | Upgrades | Settings")
